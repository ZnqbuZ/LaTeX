\bool_if:NF \g_zz_beamer_bool {

	\AtBeginEnvironment{proof}{\vspace*{-\parskip}}

	\numberwithin{equation}{section}

	\AddToHook { env/document/before } {
		\__zz_if_lang:nTF { cn } {
			\zcsetup{pairsep={ 和 }, listsep={、}, lastsep={ 及 }, rangesep={ 至 }}

			\zcRefTypeSetup{chapter}{refbounds={,第,章,}}
			\zcRefTypeSetup{section}{refbounds={,第,节,}}
			\zcRefTypeSetup{subsection}{refbounds={,第,小节,}}

			\zcrename{appendix}{附录}
			\zcnoname{chapter}
			\zcnoname{section}
			\zcnoname{subsection}

			\renewcommand{\proofname}{\indent 证明}
			\newenvironment{proof*}[1][\proofname]{\begin{proof}[#1]\renewcommand{\qedsymbol}{}}{\end{proof}}

			\renewkeytheoremstyle{remark}{
				headfont=\CJKfamily{zhkai},
				notefont=\CJKfamily{zhkai},
				bodyfont=\CJKfamily{zhkai},
				tcolorbox=ruled-thm-box,
				headindent=2em,
			}

			\renewkeytheoremstyle{definition}{
				headfont=\CJKfamily{zhkai}\bfseries,
				notefont=\CJKfamily{zhkai}\bfseries,
				bodyfont=\CJKfamily{zhsong},
				tcolorbox=ruled-thm-box,
				headindent=2em,
			}

			\renewkeytheoremstyle{plain}{
				headfont=\CJKfamily{zhkai}\bfseries,
				notefont=\CJKfamily{zhkai}\bfseries,
				bodyfont=\CJKfamily{zhkai},
				tcolorbox=thm-box,
				headindent=2em,
			}

			\NewDocumentCommand{\@DeclareTheorem}{ o m m }{
				\IfValueTF{#1}
				{\declaretheorem[name=#3, refname={#3, #3}, Refname={#3, #3}, #1]{#2}}
				{\declaretheorem[name=#3, refname={#3, #3}, Refname={#3, #3}]{#2}}
			}
		} {
			\renewkeytheoremstyle{remark}{
				headfont=\itshape,
				bodyfont=\normalfont,
				tcolorbox=ruled-thm-box
			}

			\renewkeytheoremstyle{definition}{
				headfont=\bfseries,
				bodyfont=\normalfont,
				tcolorbox=ruled-thm-box,
			}

			\renewkeytheoremstyle{plain}{
				tcolorbox=thm-box,
			}

			\NewDocumentCommand{\@DeclareTheorem}{ o m m }{
				\IfValueTF{#1}
				{\declaretheorem[name=#3, #1]{#2}}
				{\declaretheorem[name=#3]{#2}}
			}
		}

		\NewDocumentCommand{\@NewTheorem}{ O{plain} m m }{
			\@DeclareTheorem[numberlike=equation, style=#1]{#2}{#3}
			\@DeclareTheorem[numbered=no, style=#1]{#2*}{#3}
		}

		\@NewTheorem{theorem}{\l__zz_theorem_tl}
		\@NewTheorem{lemma}{\l__zz_lemma_tl}
		\@NewTheorem{corollary}{\l__zz_corollary_tl}
		\@NewTheorem{proposition}{\l__zz_proposition_tl}
		\@NewTheorem{axiom}{\l__zz_axiom_tl}

		\@NewTheorem[definition]{definition}{\l__zz_definition_tl}

		\@NewTheorem[remark]{remark}{\l__zz_remark_tl}
		\@NewTheorem[remark]{example}{\l__zz_example_tl}

		\@DeclareTheorem{maintheorem}{\l__zz_maintheorem_tl}
		\renewcommand{\themaintheorem}{\Roman{maintheorem}}
	}
}

