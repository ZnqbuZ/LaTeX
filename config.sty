\cs_new_protected:Npn \__zz_define_cmd:nn #1#2 {
	\seq_set_split:Nnn \l_tmpa_seq { = } { #2 }
	\tl_set:Nx \l_tmpa_tl { \seq_item:Nn \l_tmpa_seq { 1 } }
	\int_compare:nNnTF { \seq_count:N \l_tmpa_seq } > { 1 } {
			\tl_set:Nx \l_tmpb_tl { \seq_item:Nn \l_tmpa_seq { 2 } }
		} {
			\tl_set:Nx \l_tmpb_tl { \l_tmpa_tl }
		}

	\cs_if_exist:cT { \l_tmpa_tl } {
		\msg_fatal:nnx { zz-math } { cmd-already-defined } { \l_tmpa_tl }
	}

	\str_if_eq:nnT { #1 } { mathsf } {
		\iow_log:x { Declaring~mathsf~name:~\exp_not:c { \l_tmpa_tl }~->~{ \exp_not:N \mathsf { \exp_not:V \l_tmpb_tl } } }
		\exp_args:Ncx \newcommand { \l_tmpa_tl } { { \exp_not:N \mathsf { \exp_not:V \l_tmpb_tl } } }
	}

	\str_if_eq:nnT { #1 } { Operator } {
		\iow_log:x { Declaring~math~operator:~\exp_not:c { \l_tmpa_tl }~->~\exp_not:V \l_tmpb_tl }
		\exp_args:NcV \DeclareMathOperator { \l_tmpa_tl } \l_tmpb_tl
	}

	\str_if_eq:nnT { #1 } { Symbol } {
		\iow_log:x { Declaring~math~symbol:~\exp_not:c { \l_tmpa_tl }~->~\exp_not:V \l_tmpb_tl }
		\cs_new_protected:cpx { \l_tmpa_tl } {
			\exp_not:N \mathrm { \exp_not:V \l_tmpb_tl }
		}
	}

	\str_if_eq:nnT { #1 } { Dual } {
		\iow_log:x { Declaring~operator~&~symbol:~\exp_not:c { \l_tmpa_tl }~->~\exp_not:V \l_tmpb_tl }
		\use:e {
			\exp_not:N \NewDocumentCommand \exp_not:c { \l_tmpa_tl } { s } {
				\exp_not:N \IfBooleanTF { ##1 }
				{ \exp_not:N \mathrm { \exp_not:V \l_tmpb_tl } }
				{ \exp_not:N \operatorname { \exp_not:V \l_tmpb_tl } }
			}
		}
	}
}
