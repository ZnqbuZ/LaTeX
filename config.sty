\tcbset{
	thm-box/.style={
			enhanced,
			breakable,
			lines before break=0,
			attach title to upper,
			after title={\hskip 0.5em},
			coltitle=black,
			interior hidden,
			frame hidden,
			boxrule=0pt,
			size=minimal,
			nobeforeafter,
			after upper=\par\hrule height 0pt,
			sharp corners,
			arc=0pt,
			outer arc=0pt,
			parbox=false,
		},
	bracket depth/.store in=\bdepth,
	bracket depth=0.5em,
	bracket overhang/.store in=\boverhang,
	bracket overhang=-0\baselineskip,
	bracket rule/.store in=\brule,
	bracket rule=1.5pt,
	ruled-thm-box/.style={
			thm-box,
			right=0.7em,
			overlay unbroken={
					\draw[gray!50, line width=\brule]
					([xshift=-\bdepth, yshift=\boverhang]frame.north east) --
						([yshift=\boverhang]frame.north east) --
						([yshift=-\boverhang]frame.south east) --
						([xshift=-\bdepth, yshift=-\boverhang]frame.south east);
				},
			overlay first={
					\draw[gray!50, line width=\brule]
					([xshift=-\bdepth, yshift=\boverhang]frame.north east) --
						([yshift=\boverhang]frame.north east) --
					(frame.south east);
				},
			overlay middle={
					\draw[gray!50, line width=\brule]
					(frame.north east) -- (frame.south east);
				},
			overlay last={
					\draw[gray!50, line width=\brule]
					(frame.north east) --
					([yshift=-\boverhang]frame.south east) --
						([xshift=-\bdepth, yshift=-\boverhang]frame.south east);
				}
		}
}
