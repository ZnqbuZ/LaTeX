\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{config}[Partial Config]

% \RequirePackage{fontspec}
\RequirePackage[warnings-off={mathtools-colon,mathtools-overbracket}]{unicode-math}
\RequirePackage[default]{fontsetup}
% \setmathfont{STIX Two Math}
\setmathfont[range={\mathcal,\mathbfcal}, StylisticSet=1]{NewComputerModernMath}

\AtBeginEnvironment{proof}{\vspace*{-\parskip}}

\newcommand{\lang}{}
\newcommand{\en}{en}
\newcommand{\fr}{fr}
\newcommand{\cn}{cn}
\DeclareOption{en}{\renewcommand{\lang}{en}}
\DeclareOption{fr}{\renewcommand{\lang}{fr}}
\DeclareOption{cn}{\renewcommand{\lang}{cn}}
\DeclareOption*{\PackageWarning{preamble}{Unknown option '\CurrentOption'}}
\ProcessOptions\relax

\ifx\lang\en

\RequirePackage[english, provide=*]{babel}

\declaretheorem[name=Definition, numberlike=equation, style=definition]{definition}
\declaretheorem[name=Theorem, numberlike=equation, style=plain]{theorem}
\declaretheorem[name=Lemma, numberlike=equation, style=plain]{lemma}
\declaretheorem[name=Corollary, numberlike=equation, style=plain]{corollary}
\declaretheorem[name=Proposition, numberlike=equation, style=plain]{proposition}
\declaretheorem[name=Axiom, numberlike=equation, style=plain]{axiom}

\declaretheorem[name=Remark, numberlike=equation, style=remark]{remark}
\declaretheorem[name=Example, numberlike=equation, style=remark]{example}


\declaretheorem[name=Definition, numbered=no, style=definition]{definition*}
\declaretheorem[name=Theorem, numbered=no, style=plain]{theorem*}
\declaretheorem[name=Lemma, numbered=no, style=plain]{lemma*}
\declaretheorem[name=Corollary, numbered=no, style=plain]{corollary*}
\declaretheorem[name=Proposition, numbered=no, style=plain]{proposition*}
\declaretheorem[name=Axiom, numbered=no, style=plain]{axiom*}

\declaretheorem[name=Remark, numbered=no, style=remark]{remark*}
\declaretheorem[name=Example, numbered=no, style=remark]{example*}

\fi

\ifx\lang\fr

\RequirePackage[french, provide=*]{babel}

\declaretheorem[name=D\'efinition, numberlike=equation, style=definition]{definition}
\declaretheorem[name=Th\'eor\`eme, numberlike=equation, style=plain]{theorem}
\declaretheorem[name=Lemme, Refname={Lemme, Lemmes}, numberlike=equation, style=plain]{lemma}
\declaretheorem[name=Corollaire, numberlike=equation, style=plain]{corollary}
\declaretheorem[name=Proposition, numberlike=equation, style=plain]{proposition}
\declaretheorem[name=Axiome, numberlike=equation, style=plain]{axiom}

\declaretheorem[name=Remarque, numberlike=equation, style=remark]{remark}
\declaretheorem[name=Exemple, numberlike=equation, style=remark]{example}


\declaretheorem[name=D\'efinition, numbered=no, style=definition]{definition*}
\declaretheorem[name=Th\'eor\`eme, numbered=no, style=plain]{theorem*}
\declaretheorem[name=Lemme, Refname={Lemme, Lemmes}, numbered=no, style=plain]{lemma*}
\declaretheorem[name=Corollaire, numbered=no, style=plain]{corollary*}
\declaretheorem[name=Proposition, numbered=no, style=plain]{proposition*}
\declaretheorem[name=Axiome, numbered=no, style=plain]{axiom*}

\declaretheorem[name=Remarque, numbered=no, style=remark]{remark*}
\declaretheorem[name=Exemple, numbered=no, style=remark]{example*}

\fi

\ifx\lang\cn

\RequirePackage[fontset=none]{ctex}
% \RequirePackage[chinese, provide=*]{babel}

\setCJKmainfont{Noto Serif CJK SC}[BoldFont=Noto Serif CJK SC Bold, ItalicFont=FZQingFangSongS Bold]
\setCJKsansfont{FZLTHProGBK}[BoldFont=FZLTHProGBK DemiBold]
\setCJKmonofont{Noto Sans Mono CJK SC}

\setCJKfamilyfont{zhsong}{Noto Serif CJK SC}[BoldFont=Noto Serif CJK SC Bold]
\setCJKfamilyfont{zhhei}{FZLTHProGBK}[BoldFont=FZLTHProGBK DemiBold]
\setCJKfamilyfont{zhfs}{FZQingFangSongS Bold}
\setCJKfamilyfont{zhyou}{FZLanTingYuan-R-GBK}[BoldFont=FZLanTingYuan-DB1-GBK]
\setCJKfamilyfont{zhkai}{FZNewKai-Z03}[BoldFont=FZCuKaiS-R-GB]
\setCJKfamilyfont{zhli}{FZHuaLi-M14S}

% \renewcommand{\sectionautorefname}{节}
\crefname{section}{}{}
\crefname{chapter}{}{}
\crefname{appendix}{附录}{附录}
\creflabelformat{section}{#2第#1节#3}
\creflabelformat{chapter}{#2第#1章#3}

% \AtBeginEnvironment{proof}{\vspace*{-2\parskip}}

\renewcommand{\proofname}{\indent 证明}
\newenvironment{proof*}{\begin{proof}\renewcommand{\qedsymbol}{}}{\end{proof}}

\newenvironment{sln}{\renewcommand{\proofname}{\indent 解}\begin{proof}}{\end{proof}\renewcommand{\proofname}{\indent 证明}}
\newenvironment{sln*}{\renewcommand{\proofname}{\indent 解}\begin{proof*}\renewcommand{\proofname}{\indent 解}}{\end{proof*}\renewcommand{\proofname}{\indent 证明}}

\declaretheoremstyle[
    headfont=\CJKfamily{zhkai}\bfseries,
    notefont=\CJKfamily{zhkai}\bfseries,
    bodyfont=\CJKfamily{zhkai},
    headindent=2em
]{thmsty}

\declaretheorem[name=定义,numberlike=equation,style=thmsty]{definition}
\crefname{definition}{定义}{定义}
\declaretheorem[name=定理,numberlike=equation,style=thmsty]{theorem}
\crefname{theorem}{定理}{定理}
\declaretheorem[name=引理,numberlike=equation,style=thmsty]{lemma}
\crefname{lemma}{引理}{引理}
\declaretheorem[name=推论,numberlike=equation,style=thmsty]{corollary}
\crefname{corollary}{推论}{推论}
\declaretheorem[name=命题,numberlike=equation,style=thmsty]{proposition}
\crefname{proposition}{命题}{命题}
\declaretheorem[name=注,numberlike=equation,style=thmsty]{remark}
\crefname{remark}{注}{注}
\declaretheorem[name=例,numberlike=equation,style=thmsty]{example}
\crefname{example}{例}{例}
\declaretheorem[name=公理,numberlike=equation,style=thmsty]{axiom}
\crefname{axiom}{公理}{公理}

\declaretheorem[name=定义, numbered=no, style=thmsty]{definition*}
\crefname{definition*}{定义}{定义}
\declaretheorem[name=定理, numbered=no, style=thmsty]{theorem*}
\crefname{theorem*}{定理}{定理}
\declaretheorem[name=引理, numbered=no, style=thmsty]{lemma*}
\crefname{lemma*}{引理}{引理}
\declaretheorem[name=推论, numbered=no, style=thmsty]{corollary*}
\crefname{corollary*}{推论}{推论}
\declaretheorem[name=命题, numbered=no, style=thmsty]{proposition*}
\crefname{proposition*}{命题}{命题}
\declaretheorem[name=注, numbered=no, style=thmsty]{remark*}
\crefname{remark*}{注}{注}
\declaretheorem[name=例, numbered=no, style=thmsty]{example*}
\crefname{example*}{例}{例}
\declaretheorem[name=公理, numbered=no, style=thmsty]{axiom*}
\crefname{axiom*}{公理}{公理}

\declaretheorem[name=主定理,style=thmsty]{maintheorem}

\fi

\let\lang\undefined
\let\en\undefined
\let\fr\undefined
\let\cn\undefined
