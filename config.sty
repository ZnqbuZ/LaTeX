\NewDocumentCommand \SetupConfig { m } {
	\keys_set:nn { __zz_config } { #1 }

	\AtEndPreamble {
		\bool_if:nTF { \sys_if_engine_xetex_p: || \sys_if_engine_luatex_p: } {
			\let\circledR\relax
			\let\circledS\relax
			\RequirePackage[warnings-off={mathtools-colon, mathtools-overbracket}, bold-style=ISO]{unicode-math}
			\RequirePackage[default]{fontsetup}

			\IfFontExistsTF { NewComputerModern~Math } {
                \setmathfont[range={cal, bfcal}, StylisticSet=0]{NewComputerModern~Math}
                \setmathfont[range={"1D49C-"1D4B5, "1D4D0-"1D4E9}, StylisticSet=1]{NewComputerModern~Math}
            } {
				\setmathfont[range={cal, bfcal}, StylisticSet=0]{NewComputerModernMath}
				\setmathfont[range={"1D49C-"1D4B5, "1D4D0-"1D4E9}, StylisticSet=1]{NewComputerModernMath}
			}
		} {
			\RequirePackage{amssymb, bm}
		}
	}

	\__zz_if_lang:nTF { cn } {
		\bool_if:nF { \sys_if_engine_xetex_p: || \sys_if_engine_luatex_p: } {
			\msg_new:nnn { __zz_config } { wrong-engine-for-cn } {
				Compilation~aborted.~Please~switch~to~xelatex~or~lualatex~for~Chinese~support.
			}
			\msg_fatal:nn { __zz_config } { wrong-engine-for-cn }
		}

		\IfClassLoadedTF{ctexart}{}
		{\IfClassLoadedTF{ctexbook}{}
			{\IfClassLoadedTF{ctexrep}{}
				{\IfClassLoadedTF{ctexbeamer}{}
					{
						\msg_new:nnn { __zz_config } { not-ctex-class } { The~document~class~is~not~a~valid~ctex~class. }
						\msg_warning:nn { __zz_config } { not-ctex-class }
						\RequirePackage[fontset=none]{ctex}
						\msg_new:nnn { __zz_config } { ctex-loaded } { CTeX~package~loaded. }
						\msg_info:nn { __zz_config } { ctex-loaded }
					}
				}
			}
		}

		\@setCJKfonts
	} {
		\str_case:Vn \l_zz_lang_tl {
			{ en } {
				\RequirePackage[french, english, main=english, provide = *]{babel}
				\bool_if:NT \g_zz_beamer_bool {
					\uselanguage{English}
					\languagepath{English}
				}
			}
			{ fr } {
				\RequirePackage[english, french, main=french, provide = *]{babel}
				\bool_if:NT \g_zz_beamer_bool {
					\uselanguage{French}
					\languagepath{French}
				}
			}
		}
	}
}

\@onlypreamble\SetupConfig

\tl_new:N \l_zz_lang_tl

\clist_map_inline:nn { theorem, lemma, corollary, proposition, axiom, definition, remark, example, maintheorem, proof } {
	\tl_new:c { l__zz_#1_tl }
}

\keys_define:nn { __zz_config } {
	lang .choice:,
	theorem .tl_set:N = \l__zz_theorem_tl,
	lemma .tl_set:N = \l__zz_lemma_tl,
	corollary .tl_set:N = \l__zz_corollary_tl,
	proposition .tl_set:N = \l__zz_proposition_tl,
	axiom .tl_set:N = \l__zz_axiom_tl,
	definition .tl_set:N = \l__zz_definition_tl,
	remark .tl_set:N = \l__zz_remark_tl,
	example .tl_set:N = \l__zz_example_tl,
	maintheorem .tl_set:N = \l__zz_maintheorem_tl,
	unknown .code:n = {
			\msg_new:nnn { __zz_config } { unknown-option } { Unknown~option~'#1'. }
			\msg_warning:nnx { __zz_config } { unknown-option } { \l_keys_key_tl }
		}
}

\keys_define:nn { __zz_config } {
	lang .choices:nn =
		{ en, fr, cn }
		{
			\tl_if_empty:NTF \l_zz_lang_tl {
				\tl_set_eq:NN \l_zz_lang_tl \l_keys_choice_tl
				\str_case:Vn \l_keys_choice_tl {
					{ en } {
						\keys_set:nn { __zz_config } {
							theorem = Theorem,
							lemma = Lemma,
							corollary = Corollary,
							proposition = Proposition,
							axiom = Axiom,
							definition = Definition,
							remark = Remark,
							example = Example,
							maintheorem = Main~Theorem,
						}
					}
					{ fr } {
						\keys_set:nn { __zz_config } {
							theorem = Th\'eor\`eme,
							lemma = Lemme,
							corollary = Corollaire,
							proposition = Proposition,
							axiom = Axiome,
							definition = D\'efinition,
							remark = Remarque,
							example = Exemple,
							maintheorem = Th\'eor\`eme~Principal,
						}
					}
					{ cn } {
						\keys_set:nn { __zz_config } {
							theorem = 定理,
							lemma = 引理,
							corollary = 推论,
							proposition = 命题,
							axiom = 公理,
							definition = 定义,
							remark = 注,
							example = 例,
							maintheorem = 主定理,
						}
					}
				}
			} {
				\tl_if_eq:NNF \l_zz_lang_tl \l_keys_choice_tl {
					\msg_new:nnn { __zz_config } { lang-already-specified } { The~language~has~already~been~specified~differently. }
					\msg_fatal:nn { __zz_config } { lang-already-specified }
				}
			}
		},
	en .meta:n        = { lang = en },
	fr .meta:n        = { lang = fr },
	cn .meta:n        = { lang = cn }
}

\prg_new_conditional:Npnn \__zz_if_lang:n #1 { T , F , TF } {
	\tl_if_eq:NnTF \l_zz_lang_tl { #1 } { \prg_return_true: } { \prg_return_false: }
}

\AddToHook { env/document/before } {
	\tl_if_empty:NT \l_zz_lang_tl {
		\msg_new:nnn { __zz_config } { lang-not-specified } { The~language~must~be~specified. }
		\msg_fatal:nn { __zz_config } { lang-not-specified }
	}
}

