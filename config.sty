% region Define letters
\cs_new_protected:Npn \__zz_define_letters:nn #1#2 {
	\cs_set_protected:Npn \__zz_tmp_loop:n ##1 {
		\tl_set:Nx \l_tmpa_tl { \char_generate:nn { ##1 } { 11 } }
		\tl_set:Nx \l_tmpb_tl { #1 \l_tmpa_tl }

		\cs_if_exist:cTF { \l_tmpb_tl } {
			\msg_warning:nnx { zz-math } { cmd-already-defined } { \l_tmpb_tl }
		} {
			\exp_args:Ncx \newcommand { \l_tmpb_tl } { { \exp_not:n { #2 } { \l_tmpa_tl } } }
		}
	}

	\int_step_function:nnN { `A } { `Z } \__zz_tmp_loop:n
	\int_step_function:nnN { `a } { `z } \__zz_tmp_loop:n
}

\__zz_define_letters:nn { mcal } { \mathcal }
\sys_if_engine_pdftex:T {
	\RequirePackage{amsfonts}
	\RequirePackage{mathrsfs}

	\cs_if_exist:NF \mscr {
		\cs_new_protected:Npn \mscr #1 { \mathscr { #1 } }
	}
	\__zz_define_letters:nn { mscr } { \mathscr }

	\cs_if_exist:NF \Bbb {
		\cs_new_protected:Npn \Bbb #1 { \mathbb { #1 } }
	}
	\__zz_define_letters:nn { Bbb } { \mathbb }

	\cs_if_exist:NF \mfrak {
		\cs_new_protected:Npn \mfrak #1 { \mathfrak { #1 } }
	}
	\__zz_define_letters:nn { mfrak } { \mathfrak }
}
% endregion
