\newcommand{\lowermathbox}[1]{\mathpalette\lowermathbox@{#1}}
\newcommand{\lowermathbox@}[2]{
    \settoheight{\@tempdima}{\m@th$\smallermathstyle{X}$}
    \raisebox{-0.5\@tempdima}{\m@th$#1#2$}}

\NewOverArrowCommand{\rightptarrow@}{%
    start={},
    middle=\harrowextender,
    end={\clipbox{.5em 0pt 0pt 0pt}{$\rightharpoonup\mathrel{\mspace{-15mu}}\rightharpoonup$}},
    trim start=0,
    trim middle=3,
    trim end=2,
    shift left=5,
    shift right=-1
}

\NewOverArrowCommand{\rightptarrowx@}{%
    start={\hphantom{\smallermathstyle X}},
    middle=\harrowextender,
    end={\clipbox{.5em 0pt 0pt 0pt}{$\rightharpoonup\mathrel{\mspace{-15mu}}\rightharpoonup$}},
    trim start=1,
    trim middle=2,
    trim end=1,
    shift left=-2,
    shift right=-2
}

\newcommand{\rightparatrans}[2][\@nil]{%
    \def\tmp{#1}%
    \ifx\tmp\@nnil
        \rightptarrow@{#2}
    \else
        \settowidth{\@tempdima}{$#1$}
        \tensor[^{\lowermathbox{\smallermathstyle{#1}}\mspace{-12mu}}]{{\rightptarrowx@{#2}}}{}
        
    \fi
}

\NewOverArrowCommand{\leftptarrow@}{%
    start={\clipbox{0pt 0pt .5em 0pt}{$\leftharpoonup\mathrel{\mspace{-15mu}}\leftharpoonup$}},
    middle=\harrowextender,
    end={},
    trim start=2,
    trim middle=3,
    trim end=0,
    shift left=2,
    shift right=2
}

\NewOverArrowCommand{\leftptarrowx@}{%
    start={\clipbox{0pt 0pt .5em 0pt}{$\leftharpoonup\mathrel{\mspace{-15mu}}\leftharpoonup$}},
    middle=\harrowextender,
    end={\hphantom{\smallermathstyle X}},
    trim start=1,
    trim middle=2,
    trim end=0,
    shift left=2,
    shift right=-4
}

\newcommand{\leftparatrans}[2][\@nil]{%
    \def\tmp{#1}%
    \ifx\tmp\@nnil
        \leftptarrow@{#2}
    \else
        \settowidth{\@tempdima}{$#1$}
        \tensor{{\leftptarrowx@{#2}}}{^{\mspace{-12mu}\lowermathbox{\smallermathstyle{#1}}}}
        
    \fi
}

