\cs_new_protected:Npn \__zz_declare_math_operator:n #1
{
    \regex_extract_once:nnNTF { ^(.*?)=(.*)$ } { #1 } \l_tmpa_seq
    {
        \seq_pop_left:NN \l_tmpa_seq \l_tmpa_tl
        
        \seq_pop_left:NN \l_tmpa_seq \l_tmpa_tl
        \seq_pop_left:NN \l_tmpa_seq \l_tmpb_tl
    }
    {
        \tl_set:Nn \l_tmpa_tl { #1 }
        \tl_set:Nn \l_tmpb_tl { #1 }
    }

    \exp_args:Nx \iow_log:n  { Declaring~operator: ~\exp_not:c \l_tmpa_tl~ -> ~\exp_not:V \l_tmpb_tl }
    \exp_args:NcV \DeclareMathOperator { \l_tmpa_tl } { \l_tmpb_tl }
}

\clist_const:Nn \l_zz_math_operator_list
{
    Log, Def, ev, im, codim, itr=int, tr, ch=char,
    sgn, sing, diam, diagop=diag, arcsinh, arccosh,
    arctanh, arccoth, pr, proj, rank,
    supp, grad=\mathbf{grad}, dvs=div, diver=div, curl, rot=\mathbf{rot}, ric=Ricci, ein=Einstein, len, inc, rad, soc,
    Ann, Der, Aut, Iso, End, Hom,
    Nat, Lie, Syl, Orb, orb, Stab,
    Gal, M, GL, SL, U, SU, OO=O, SO, so=\mathfrak{so}, hol,
    Hol, ord, Norm, Trace, A, con,
    ad, Ad, spanspace=span, gr, Eff, DscDt=DD, dis, Spec, Specm,
    Frac, hght=ht, depth, T, Proj, vol, Gr,
    res, Ext, Tor, Lan, Ran, ob, mor,
    dom, codom, coker, cov, Cov, Sv,
    rt
}

\clist_map_function:NN \l_zz_math_operator_list \__zz_declare_math_operator:n

