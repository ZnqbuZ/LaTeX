\newcommand{\q}[2]{{\ThisStyle{
                {\raisebox{0.5\nulldelimiterspace}{\ensuremath{\SavedStyle{#1}}}}
                    {
                        \kern-\nulldelimiterspace
                        \left.
                        \vphantom{\ensuremath{\SavedStyle{#1}}}
                        \kern-\nulldelimiterspace
                        \middle/
                        \kern-\nulldelimiterspace
                        \vphantom{\ensuremath{\SavedStyle{#2}}}
                        \right.
                        \kern-\nulldelimiterspace
                    }
                    {\raisebox{-0.5\nulldelimiterspace}{\ensuremath{\SavedStyle{#2}}}}
            }}}
\newcommand{\coq}[2]{{\ThisStyle{
                {\raisebox{-0.5\nulldelimiterspace}{\ensuremath{\SavedStyle{#2}}}}
                    {
                        \kern-\nulldelimiterspace
                        \left.
                        \vphantom{\ensuremath{\SavedStyle{#2}}}
                        \kern-\nulldelimiterspace
                        \middle\backslash
                        \kern-\nulldelimiterspace
                        \vphantom{\ensuremath{\SavedStyle{#1}}}
                        \right.
                        \kern-\nulldelimiterspace
                    }
                    {\raisebox{0.5\nulldelimiterspace}{\ensuremath{\SavedStyle{#1}}}}
            }}}

